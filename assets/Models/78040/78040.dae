        <effect id="MAT-fx" name="b_white">
            <profile_COMMON>
                <image id="IMAGE" height="0" width="0">
                    <init_from>/C:/Users/huydo/Downloads/___OPEN3D/Sketchfab/temp/78040/textures/b_white_baseColor.jpeg</init_from>
                </image>
                <technique sid="standard">
                    <phong>
                        <emission>
                            <color>0 0 0 1</color>
                        </emission>
                        <ambient>
                            <color>0.117647 0.117647 0.117647 1</color>
                        </ambient>
                        <diffuse>
                            <texture texture="IMAGE" texcoord="" />
                        </diffuse>
                        <specular>
                            <color>0.752941 0.752941 0.752941 1</color>
                        </specular>
                        <shininess>
                            <float>0.6</float>
                        </shininess>
                        <reflective>
                            <color>0 0 0 1</color>
                        </reflective>
                        <reflectivity>
                            <float>1</float>
                        </reflectivity>
                        <transparent>
                            <color>1 1 1 1</color>
                        </transparent>
                        <transparency>
                            <float>0</float>
                        </transparency>
                    </phong>
                </technique>
            </profile_COMMON>
